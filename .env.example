# 使用 Neon、Vercel Postgres 或其他兼容 PostgreSQL 的连接串。
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flowboard

# 数据库连接等待秒数；Neon 冷启动场景建议保持 30 秒。
DATABASE_CONNECT_TIMEOUT_SECONDS=30

# 生产站点地址，用于社交分享卡片。
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 会话有效期（天）
SESSION_TTL_DAYS=7

# 初始化管理员；生产环境务必替换密码。
SEED_ADMIN_EMAIL=admin@flowboard.local
SEED_ADMIN_PASSWORD=Admin@123456

# 仅本地演示数据库设为 true；生产环境必须设为 false。
SEED_DEMO_DATA=true

# 仅本地演示时展示测试账号提示。
NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS=true
